# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# Relational Database Connection (Prisma & Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@YOUR-PROJECT-REF.supabase.co:5432/postgres"

# Direct URL for Prisma migrations
DIRECT_URL="postgresql://postgres:YOUR-PASSWORD@YOUR-PROJECT-REF.supabase.co:5432/postgres"

# Supabase Auth and Client SDK Credentials
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Super Admin Account Configuration
SUPER_ADMIN_EMAIL="admin@example.com"

# Secret used to HMAC-sign the q-clinix-session cookie.
# MUST be a long random string in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: enable the passwordless login-fallback endpoint (DEV ONLY, ignored in production)
# ENABLE_LOGIN_FALLBACK="true"

# Optional SMTP settings for the email notification provider
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="Q-Clinix <no-reply@example.com>"